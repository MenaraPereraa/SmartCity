<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Set before including: statLabel, statValue, statIcon (e.g. bi-inbox), statChip (e.g. bg-indigo-50 text-indigo-600) --%>
<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-slate-500"><c:out value="${statLabel}"/></span>
        <span class="grid h-9 w-9 place-items-center rounded-lg ${statChip}"><i class="bi ${statIcon}"></i></span>
    </div>
    <div class="mt-3 text-3xl font-bold tracking-tight text-slate-900"><c:out value="${statValue}"/></div>
</div>

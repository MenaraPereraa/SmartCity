<%-- Needs: rows (list of ComplaintView), showReporter (boolean), emptyText (string) --%>
<%@ include file="/WEB-INF/views/layout/badge-map.jspf" %>
<c:choose>
    <c:when test="${empty rows}">
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-14 text-center">
            <i class="bi bi-inbox text-4xl text-slate-300"></i>
            <p class="mt-2 text-sm text-slate-500"><c:out value="${empty emptyText ? 'No complaints to show.' : emptyText}"/></p>
        </div>
    </c:when>
    <c:otherwise>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-100 text-sm">
                    <thead class="bg-slate-50 text-left text-xs font-semibold text-slate-500">
                    <tr>
                        <th class="px-4 py-3">#</th>
                        <th class="px-4 py-3">Category</th>
                        <th class="px-4 py-3">Description</th>
                        <th class="px-4 py-3">Zone</th>
                        <c:if test="${showReporter}"><th class="px-4 py-3">Reporter</th></c:if>
                        <th class="px-4 py-3">Severity</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">With</th>
                        <th class="px-4 py-3">Submitted</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                    <c:forEach var="cv" items="${rows}">
                        <c:set var="sevCls" value="${empty badgeMap[cv.severityBadge] ? badgeDefault : badgeMap[cv.severityBadge]}"/>
                        <c:set var="stCls"  value="${empty badgeMap[cv.statusBadge]   ? badgeDefault : badgeMap[cv.statusBadge]}"/>
                        <tr class="transition hover:bg-slate-50/80">
                            <td class="whitespace-nowrap px-4 py-3 font-bold">
                                <a class="text-blue-600 hover:underline" href="${ctx}/app/complaints/view?id=${cv.id}">#${cv.id}</a>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 font-medium"><c:out value="${cv.categoryName}"/></td>
                            <td class="px-4 py-3">
                                <a href="${ctx}/app/complaints/view?id=${cv.id}"
                                   class="block max-w-[260px] truncate text-slate-600 hover:text-slate-900"
                                   title="<c:out value='${cv.description}'/>"><c:out value="${cv.description}"/></a>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-slate-600"><c:out value="${cv.zoneName}"/></td>
                            <c:if test="${showReporter}"><td class="whitespace-nowrap px-4 py-3 text-slate-600"><c:out value="${cv.reporterName}"/></td></c:if>
                            <td class="whitespace-nowrap px-4 py-3">
                                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold ring-1 ring-inset ${sevCls}">
                                    <c:out value="${cv.severityLabel}"/> (${cv.severity})
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3">
                                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold ring-1 ring-inset ${stCls}">
                                    <c:out value="${cv.statusLabel}"/>
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-slate-600"><c:out value="${cv.currentLevel}"/></td>
                            <td class="whitespace-nowrap px-4 py-3 text-slate-500"><c:out value="${cv.createdAtText}"/></td>
                        </tr>
                    </c:forEach>
                    </tbody>
                </table>
            </div>
        </div>
    </c:otherwise>
</c:choose>

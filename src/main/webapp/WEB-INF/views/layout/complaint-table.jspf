<%-- Needs: rows (list of ComplaintView), showReporter (boolean), emptyText (string) --%>
<c:choose>
    <c:when test="${empty rows}">
        <div class="alert alert-light border"><c:out value="${emptyText}"/></div>
    </c:when>
    <c:otherwise>
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white shadow-sm mb-0">
                <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Zone</th>
                    <c:if test="${showReporter}"><th>Reporter</th></c:if>
                    <th>Severity</th>
                    <th>Status</th>
                    <th>With</th>
                    <th>Submitted</th>
                </tr>
                </thead>
                <tbody>
                <c:forEach var="cv" items="${rows}">
                    <tr>
                        <td><a href="${ctx}/app/complaints/view?id=${cv.id}">#${cv.id}</a></td>
                        <td><c:out value="${cv.categoryName}"/></td>
                        <td><span class="d-inline-block text-truncate" style="max-width: 240px;"><c:out value="${cv.description}"/></span></td>
                        <td><c:out value="${cv.zoneName}"/></td>
                        <c:if test="${showReporter}"><td><c:out value="${cv.reporterName}"/></td></c:if>
                        <td><span class="badge text-bg-${cv.severityBadge}"><c:out value="${cv.severityLabel}"/> (${cv.severity})</span></td>
                        <td><span class="badge text-bg-${cv.statusBadge}"><c:out value="${cv.statusLabel}"/></span></td>
                        <td><c:out value="${cv.currentLevel}"/></td>
                        <td class="text-nowrap"><c:out value="${cv.createdAtText}"/></td>
                    </tr>
                </c:forEach>
                </tbody>
            </table>
        </div>
    </c:otherwise>
</c:choose>

<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en" class="bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle != null ? pageTitle : 'SmartCity'}"/></title>

    <%-- Tailwind (CDN) --%>
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Manrope', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'] } } }
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%-- Icons --%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <%-- Old pages (login, dashboard, zones, street lights) still use Bootstrap.
         Keep this line until you convert them. Remove it after. --%>
    <%-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"> --%>
</head>
<body class="font-sans text-slate-800 antialiased">

<%-- Dark overlay for the mobile menu --%>
<div id="sc-overlay" class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"></div>

<%-- ───────── Sidebar ───────── --%>
<nav id="sc-sidebar"
     class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-white/5 bg-[#090d16] text-slate-400 transition-transform duration-200 lg:translate-x-0">

    <div class="flex items-center gap-3 px-5 py-6">
        <div class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 text-sm font-extrabold text-white shadow-lg shadow-indigo-500/30">SC</div>
        <div class="text-lg font-extrabold tracking-tight text-white">SmartCity</div>
    </div>

    <div class="flex-1 space-y-1 overflow-y-auto px-4 pb-4">
        <div class="px-3 pb-2 text-xs font-semibold text-slate-500">Main menu</div>

        <a href="${ctx}/app/dashboard" data-path="/app/dashboard"
           class="sc-nav-link flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition hover:bg-white/5 hover:text-white [&.active]:bg-slate-800 [&.active]:text-white [&.active]:ring-1 [&.active]:ring-inset [&.active]:ring-white/10">
            <i class="bi bi-speedometer2 text-lg"></i> Dashboard
        </a>

        <c:if test="${sessionScope.user.staff}">
            <a href="${ctx}/app/inbox" data-path="/app/inbox"
               class="sc-nav-link flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition hover:bg-white/5 hover:text-white [&.active]:bg-slate-800 [&.active]:text-white [&.active]:ring-1 [&.active]:ring-inset [&.active]:ring-white/10">
                <i class="bi bi-inbox text-lg"></i> Complaints inbox
            </a>
        </c:if>

        <c:if test="${sessionScope.user.resident}">
            <a href="${ctx}/app/my-complaints" data-path="/app/my-complaints"
               class="sc-nav-link flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition hover:bg-white/5 hover:text-white [&.active]:bg-slate-800 [&.active]:text-white [&.active]:ring-1 [&.active]:ring-inset [&.active]:ring-white/10">
                <i class="bi bi-file-text text-lg"></i> My complaints
            </a>
        </c:if>

        <%-- Show the "Modules" title only when the user can open at least one module --%>
        <c:if test="${sessionScope.user.canAccessEnergy or sessionScope.user.canAccessStreetLights or sessionScope.user.canAccessZoneCommand}">
            <div class="px-3 pb-2 pt-5 text-xs font-semibold text-slate-500">Modules</div>
        </c:if>

        <c:if test="${sessionScope.user.canAccessEnergy}">
            <a href="${ctx}/app/energy" data-path="/app/energy"
               class="sc-nav-link flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition hover:bg-white/5 hover:text-white [&.active]:bg-slate-800 [&.active]:text-white [&.active]:ring-1 [&.active]:ring-inset [&.active]:ring-white/10">
                <i class="bi bi-lightning-charge text-lg"></i> Energy management
            </a>
        </c:if>

        <c:if test="${sessionScope.user.canAccessStreetLights}">
            <a href="${ctx}/app/street-lights" data-path="/app/street-lights"
               class="sc-nav-link flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition hover:bg-white/5 hover:text-white [&.active]:bg-slate-800 [&.active]:text-white [&.active]:ring-1 [&.active]:ring-inset [&.active]:ring-white/10">
                <i class="bi bi-lightbulb text-lg"></i> Street lights
            </a>
        </c:if>

        <c:if test="${sessionScope.user.canAccessZoneCommand}">
            <a href="${ctx}/app/zones" data-path="/app/zones"
               class="sc-nav-link flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition hover:bg-white/5 hover:text-white [&.active]:bg-slate-800 [&.active]:text-white [&.active]:ring-1 [&.active]:ring-inset [&.active]:ring-white/10">
                <i class="bi bi-diagram-3 text-lg"></i> Zone commands
            </a>
        </c:if>
    </div>

    <div class="border-t border-white/5 p-4">
        <div class="mb-3 flex items-center gap-3 px-2">
            <div class="grid h-9 w-9 flex-none place-items-center rounded-full bg-slate-700 text-sm font-bold text-white">
                <c:out value="${sessionScope.user.firstName.substring(0,1).toUpperCase()}"/>
            </div>
            <div class="min-w-0">
                <div class="truncate text-sm font-semibold text-white"><c:out value="${sessionScope.user.fullName}"/></div>
                <div class="truncate text-xs text-slate-400"><c:out value="${sessionScope.user.roleDisplay}"/></div>
            </div>
        </div>
        <a href="${ctx}/logout"
           class="flex w-full items-center justify-center gap-2 rounded-xl border border-red-500/20 bg-red-500/10 px-3 py-2.5 text-sm font-semibold text-red-400 transition hover:bg-red-500 hover:text-white">
            <i class="bi bi-box-arrow-right"></i> Sign out
        </a>
    </div>
</nav>

<script>
    (function () {
        // highlight the current menu link
        var path = location.pathname;
        document.querySelectorAll('.sc-nav-link[data-path]').forEach(function (a) {
            if (path.indexOf(a.getAttribute('data-path')) !== -1) a.classList.add('active');
        });

        // mobile menu
        var side = document.getElementById('sc-sidebar');
        var overlay = document.getElementById('sc-overlay');
        function toggle(open) {
            side.classList.toggle('-translate-x-full', !open);
            overlay.classList.toggle('hidden', !open);
        }
        document.addEventListener('click', function (e) {
            if (e.target.closest('[data-menu-open]')) toggle(true);
            else if (e.target === overlay) toggle(false);
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') toggle(false); });
    })();
</script>

<%-- ───────── Main area ───────── --%>
<div class="lg:pl-64">

    <%-- Top bar: phones and small tablets only --%>
    <div class="sticky top-0 z-20 flex items-center gap-3 border-b border-slate-200 bg-white/90 px-4 py-3 backdrop-blur lg:hidden">
        <button type="button" data-menu-open aria-label="Open menu"
                class="grid h-9 w-9 place-items-center rounded-lg text-xl text-slate-700 hover:bg-slate-100">
            <i class="bi bi-list"></i>
        </button>
        <span class="font-extrabold tracking-tight">SmartCity360</span>
    </div>

    <main class="min-h-screen p-4 sm:p-8">

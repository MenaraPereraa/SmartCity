<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<c:out value='${csrfToken}'/>">
  <title><c:out value="${pageTitle}"/> | SmartCity360</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="${ctx}/assets/css/styles.css">
</head>
<body>

<%-- Flash data element (read by sidebar.js) --%>
<c:if test="${not empty flashMessage}">
  <div id="sc-flash-data" class="hidden"
       data-message="<c:out value='${flashMessage}'/>"
       data-type="<c:out value='${flashType}'/>"></div>
</c:if>

<%-- Mobile sidebar overlay --%>
<div id="sc-sidebar-overlay" class="fixed inset-0 bg-black/50 z-20 hidden md:hidden"></div>

<%-- ════════════════ SIDEBAR ════════════════ --%>
<aside id="sc-sidebar" class="sc-sidebar">

  <%-- Logo --%>
  <div class="sc-sidebar-logo">
    <div class="sc-sidebar-logo-icon">S</div>
    <div>
      <div class="sc-sidebar-logo-text">SmartCity360</div>
      <div class="sc-sidebar-logo-sub">Urban Intelligence Platform</div>
    </div>
  </div>

  <%-- Navigation --%>
  <nav class="flex-1 py-3 overflow-y-auto">

    <div class="sc-nav-section-label">Overview</div>
    <a href="${ctx}/app/dashboard" class="sc-nav-link" data-path="/app/dashboard">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Dashboard
    </a>

    <%-- RESIDENT links --%>
    <c:if test="${sessionScope.user.resident}">
      <div class="sc-nav-section-label">My Area</div>
      <a href="${ctx}/app/complaints/new" class="sc-nav-link" data-path="/app/complaints/new">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        Report Problem
      </a>
      <a href="${ctx}/app/my-complaints" class="sc-nav-link" data-path="/app/my-complaints">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        My Complaints
      </a>
    </c:if>

    <%-- STAFF links --%>
    <c:if test="${sessionScope.user.staff}">
      <div class="sc-nav-section-label">Staff Console</div>
      <a href="${ctx}/app/inbox" class="sc-nav-link" data-path="/app/inbox">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
        Complaint Inbox
      </a>
      <c:if test="${sessionScope.user.canAccessEnergy}">
        <a href="${ctx}/app/energy" class="sc-nav-link" data-path="/app/energy">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Energy
        </a>
      </c:if>
      <c:if test="${sessionScope.user.canAccessStreetLights}">
        <a href="${ctx}/app/street-lights" class="sc-nav-link" data-path="/app/street-lights">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="3"/><circle cx="12" cy="8" r="5"/><path d="M12 13v3"/><path d="M8 16l-2 3h12l-2-3"/></svg>
          Street Lights
        </a>
      </c:if>
      <c:if test="${sessionScope.user.canAccessZoneCommand}">
        <a href="${ctx}/app/zones" class="sc-nav-link" data-path="/app/zones">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
          Zone Explorer
        </a>
      </c:if>
      <c:if test="${sessionScope.user.canAccessPolicy}">
        <a href="${ctx}/app/policy" class="sc-nav-link" data-path="/app/policy">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Policies
        </a>
      </c:if>
    </c:if>

  </nav>

  <%-- Sidebar footer: user + logout --%>
  <div class="sc-sidebar-footer">
    <div class="sc-user-chip">
      <div class="sc-avatar">
        ${fn:substring(sessionScope.user.firstName, 0, 1)}${fn:substring(sessionScope.user.lastName, 0, 1)}
      </div>
      <div class="min-w-0">
        <div class="text-sm font-semibold text-slate-200 truncate"><c:out value="${sessionScope.user.fullName}"/></div>
        <div class="text-xs text-slate-400"><c:out value="${sessionScope.user.roleDisplay}"/></div>
      </div>
    </div>
    <form method="post" action="${ctx}/logout">
      <input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>">
      <button type="submit"
              class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:bg-slate-800 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign out
      </button>
    </form>
  </div>
</aside>

<%-- ════════════════ SHELL / MAIN AREA ════════════════ --%>
<div class="sc-shell">

  <%-- Top bar --%>
  <header class="sc-topbar">
    <div class="flex items-center gap-3">
      <%-- Mobile hamburger --%>
      <button id="sc-menu-open" class="md:hidden p-1.5 rounded-lg hover:bg-slate-100 text-slate-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1 class="text-sm font-semibold text-slate-700"><c:out value="${pageTitle}"/></h1>
    </div>
    <div class="flex items-center gap-2 text-sm text-slate-500">
      <span class="hidden sm:inline"><c:out value="${sessionScope.user.fullName}"/></span>
      <span class="badge badge-blue"><c:out value="${sessionScope.user.roleDisplay}"/></span>
    </div>
  </header>

  <%-- Page content area --%>
  <main class="sc-page-content">

<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Shortcuts to the modules this user may open (nothing is drawn if there are none) --%>
<c:if test="${sessionScope.user.canAccessEnergy or sessionScope.user.canAccessStreetLights or sessionScope.user.canAccessZoneCommand}">
    <section>
        <h2 class="mb-3 text-base font-semibold text-slate-900">Quick access</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">

            <c:if test="${sessionScope.user.canAccessEnergy}">
                <a href="${ctx}/app/energy"
                   class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-indigo-300 hover:shadow-sm">
                    <span class="grid h-10 w-10 flex-none place-items-center rounded-lg bg-indigo-50 text-indigo-600"><i class="bi bi-lightning-charge text-lg"></i></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-semibold text-slate-900">Energy management</span>
                        <span class="block text-xs text-slate-500">Meter readings and streams</span>
                    </span>
                </a>
            </c:if>

            <c:if test="${sessionScope.user.canAccessStreetLights}">
                <a href="${ctx}/app/street-lights"
                   class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-amber-300 hover:shadow-sm">
                    <span class="grid h-10 w-10 flex-none place-items-center rounded-lg bg-amber-50 text-amber-600"><i class="bi bi-lightbulb text-lg"></i></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-semibold text-slate-900">Street lights</span>
                        <span class="block text-xs text-slate-500">View and control lights</span>
                    </span>
                </a>
            </c:if>

            <c:if test="${sessionScope.user.canAccessZoneCommand}">
                <a href="${ctx}/app/zones"
                   class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-emerald-300 hover:shadow-sm">
                    <span class="grid h-10 w-10 flex-none place-items-center rounded-lg bg-emerald-50 text-emerald-600"><i class="bi bi-diagram-3 text-lg"></i></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-semibold text-slate-900">Zone commands</span>
                        <span class="block text-xs text-slate-500">Send commands to a zone</span>
                    </span>
                </a>
            </c:if>

        </div>
    </section>
</c:if>
